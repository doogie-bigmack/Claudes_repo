# Polymarket Arbitrage Bot Configuration
# Copy this file to .env and fill in your values

# ============================================
# WALLET CONFIGURATION
# ============================================
# Your Polygon wallet private key (without 0x prefix)
# NEVER commit this to version control!
PRIVATE_KEY=your_private_key_here

# Your wallet address
WALLET_ADDRESS=0xYourWalletAddress

# ============================================
# API CONFIGURATION
# ============================================
# Polymarket API endpoints
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws

# Optional: Kalshi API for cross-platform arbitrage
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_API_SECRET=your_kalshi_api_secret

# ============================================
# TRADING CONFIGURATION
# ============================================
# Minimum profit threshold (as decimal, e.g., 0.01 = 1%)
MIN_PROFIT_THRESHOLD=0.005

# Maximum position size per trade in USDC
MAX_POSITION_SIZE=100.0

# Total capital allocated for trading
TOTAL_CAPITAL=1000.0

# Maximum percentage of capital per trade
MAX_CAPITAL_PER_TRADE=0.10

# Slippage tolerance (as decimal)
SLIPPAGE_TOLERANCE=0.005

# ============================================
# FEE CONFIGURATION
# ============================================
# Polymarket taker fee (dynamic, up to 3.15%)
TAKER_FEE_RATE=0.0315

# Gas estimate per trade (in MATIC)
GAS_ESTIMATE=0.001

# ============================================
# RISK MANAGEMENT
# ============================================
# Maximum daily loss limit (as percentage of capital)
MAX_DAILY_LOSS=0.05

# Maximum number of open positions
MAX_OPEN_POSITIONS=10

# Cooldown between trades (seconds)
TRADE_COOLDOWN=5

# ============================================
# MONITORING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ============================================
# MARKET FILTERS
# ============================================
# Target market types (comma-separated)
# Options: btc_hourly, eth_hourly, btc_15min, eth_15min, all
TARGET_MARKETS=btc_hourly,eth_hourly

# Minimum liquidity threshold
MIN_LIQUIDITY=500
